# Configuración del Modelo de Inteligencia Artificial (vía LiteLLM)
# Modelo predeterminado: gemini/gemini-1.5-pro-preview
LLM_MODEL=gemini/gemini-1.5-pro-preview

# Claves de API (Configura la correspondiente al LLM_MODEL que utilices)
# Para Gemini (predeterminado):
GEMINI_API_KEY=tu_clave_de_api_de_gemini
# Para OpenAI:
# OPENAI_API_KEY=tu_clave_de_api_de_openai
# Para Anthropic:
# ANTHROPIC_API_KEY=tu_clave_de_api_de_anthropic

# =========================================================================
# Optimización de Concurrencia (Rate Limits y Paralelismo)
# =========================================================================
# SINGLE_REQUEST_MODE: 
# Si es "true", unifica todos los archivos modificados en 1 sola llamada a la IA 
# (Ideal para burlar los Rate Limits de APIs gratuitas como Gemini Free).
# Si es "false", enviará concurrentemente llamadas paralelas por cada archivo (ideal para APIs pagadas hiper-rápidas).
SINGLE_REQUEST_MODE=true

# Solo aplica si SINGLE_REQUEST_MODE=false. Define cuántas peticiones simultáneas
# se harán al LLM por segundo. (Aviso: Modelos gratuitos colapsarán si es mayor a 1 o 2).
MAX_CONCURRENT_REVIEWS=5

# =========================================================================
# Variables para revisión en Pull Requests (review_pr.py)
# NOTA: En GitHub Actions, estas variables suelen inyectarse automáticamente
# mediante los contextos secrets.GITHUB_TOKEN, github.repository, etc.
# Solo necesitas configurarlas aquí si deseas probar review_pr.py de forma
# local simulando el entorno de CI.
# =========================================================================
GITHUB_TOKEN=tu_token_de_acceso_personal_de_github
GITHUB_REPOSITORY=usuario/repositorio
PR_NUMBER=1
